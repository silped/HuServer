export bool test_system()
{
    HU_LOG_NDEBUG( _T( "시스템 전체 메모리 = {} MB" ), util::get_total_memory() );
    HU_LOG_NDEBUG( _T( "시스템 사용 메모리 = {} MB" ), util::get_memory_usage() );
